# fund-research-agent 环境变量模板。
# 用法：python scripts/gen_env.py --llm-key-file <DeepSeek key 文件>  → 生成 .env（已被 gitignore）。
# 值为空且标了 [secret] 的变量由 gen_env.py 随机生成；LLM_API_KEY 从 --llm-key-file 读取。
# 本文件的变量与代码实际读取的变量一一对应（CLAUDE.md §5）；标了 (Sx 起) 的变量在对应阶段才被读取。

# ---------------------------------------------------------------- compose
# compose 项目名：容器名前缀、具名卷前缀
COMPOSE_PROJECT_NAME=fra

# ---------------------------------------------------------------- 宿主机端口（PLAN §2.2，避开 ticket-qa 的 3306/6379/8080/8089/9090/5672）
MYSQL_PORT=3307
REDIS_PORT=6380
ES_PORT=9201
MILVUS_PORT=19530
# Milvus 管理/健康检查端口（/healthz、/metrics）
MILVUS_METRICS_PORT=9091
# (S11 起) Kafka 对宿主机的 listener 端口
KAFKA_PORT=9094
BACKEND_PORT=8081
AI_SERVICE_PORT=8001
# (S9 起) ai-service 的 gRPC 端口
AI_GRPC_PORT=50051
# (S5 起) mcp-tools 的 streamable HTTP 端口
MCP_TOOLS_PORT=8101
# (S7 起) 前端 nginx 端口
FRONTEND_PORT=8088

# ---------------------------------------------------------------- MySQL（两个库：fra_app 业务库、fund_data 基金数据快照库）
# 应用在 Windows 本机运行时连 127.0.0.1:MYSQL_PORT；容器内互连用服务名 mysql:3306
MYSQL_HOST=127.0.0.1
# [secret] root 密码，仅用于初始化与运维
MYSQL_ROOT_PASSWORD=
# 业务库与应用账号（只有 fra_app 库的权限）
MYSQL_APP_DB=fra_app
MYSQL_APP_USER=fra_app
# [secret]
MYSQL_APP_PASSWORD=
# 基金数据库与只读账号（fund_data 上只有 SELECT，供 mcp-tools 的 run_fund_sql 使用）
FUND_DATA_DB=fund_data
FUND_READER_USER=fund_reader
# [secret]
FUND_READER_PASSWORD=

# ---------------------------------------------------------------- Redis 8（自带 Query Engine / 向量索引）
REDIS_HOST=127.0.0.1
# [secret]
REDIS_PASSWORD=

# ---------------------------------------------------------------- Elasticsearch 8 + IK（本地开发关闭安全认证，见 ADR）
ES_URL=http://127.0.0.1:9201

# ---------------------------------------------------------------- Milvus 2.5 standalone
MILVUS_URI=http://127.0.0.1:19530

# ---------------------------------------------------------------- 健康检查
# health 接口里每个依赖探测的超时（秒）
HEALTH_TIMEOUT_SECONDS=2

# ---------------------------------------------------------------- LLM（DeepSeek，OpenAI 兼容）
LLM_BASE_URL=https://api.deepseek.com
# [secret] 由 gen_env.py 从 --llm-key-file 读取写入；不打印、不写日志
LLM_API_KEY=
# 通用对话模型（需支持流式 + tool calling）；选择依据见 docs/DECISIONS.md 与 S0 的 llm_smoke 结果
LLM_MODEL=deepseek-flash
# DeepSeek 思考模式：enabled | disabled（官方默认 enabled；开启时多轮 tool call 必须回传 reasoning_content，见 ADR）
LLM_THINKING=disabled
# (S8 起) 回答评测的 LLM 裁判模型，刻意与被测模型不同
JUDGE_MODEL=deepseek-v4-pro
# 单次 LLM 请求超时（秒）
LLM_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------- 本地模型（S2 起）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# cross_encoder | noop
RERANKER_PROVIDER=cross_encoder
RERANKER_MODEL=BAAI/bge-reranker-base
HF_ENDPOINT=https://hf-mirror.com
# 模型缓存目录（相对仓库根，已 gitignore）
MODEL_CACHE_DIR=.cache/models

# ---------------------------------------------------------------- 数据（S1 起）
# 结构化数据截止日，S1 确定后冻结，例如 2026-09-30
DATA_AS_OF=
# get_latest_nav 使用的东方财富净值接口（非官方，需 Referer）
NAV_API_BASE_URL=https://api.fund.eastmoney.com

# ---------------------------------------------------------------- 服务间（S6 起）
# backend 调 ai-service 的地址
AI_SERVICE_BASE_URL=http://127.0.0.1:8001
# [secret] ai-service → backend 回调（文档入库状态）的共享密钥
INTERNAL_CALLBACK_SECRET=
# [secret] JWT 签名密钥
JWT_SECRET=
