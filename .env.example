# fund-research-agent 环境变量模板。
# 用法：python scripts/gen_env.py --llm-key-file <DeepSeek key 文件>  → 生成 .env（已被 gitignore）。
# 值为空且标了 [secret] 的变量由 gen_env.py 随机生成；LLM_API_KEY 从 --llm-key-file 读取。
# 本文件的变量与代码实际读取的变量一一对应（CLAUDE.md §5）；标了 (Sx 起) 的变量在对应阶段才被读取。

# ---------------------------------------------------------------- compose
# compose 项目名：容器名前缀、具名卷前缀
COMPOSE_PROJECT_NAME=fra

# ---------------------------------------------------------------- 宿主机端口（PLAN §2.2，避开 ticket-qa 的 3306/6379/8080/8089/9090/5672）
MYSQL_PORT=3307
REDIS_PORT=6380
ES_PORT=9201
MILVUS_PORT=19530
# Milvus 管理/健康检查端口（/healthz、/metrics）
MILVUS_METRICS_PORT=9091
# (S11 起) Kafka 对宿主机的 listener 端口
KAFKA_PORT=9094
BACKEND_PORT=8081
AI_SERVICE_PORT=8001
# (S9 起) ai-service 的 gRPC 服务（grpc.aio，与 HTTP 同进程）：开关 / 监听地址 / 端口。
# 本机同时起多个 ai-service（如评测时的两个检索配置）时，只能有一个占 50051：其余的设 AI_GRPC_ENABLED=false。
# 端口被占用时 ai-service 只记 error 日志、HTTP 照常服务。gRPC 端口没有鉴权，只在内网 / 回环暴露。
AI_GRPC_ENABLED=true
AI_GRPC_HOST=127.0.0.1
AI_GRPC_PORT=50051
# (S5 起) mcp-tools 的 streamable HTTP 端口；监听地址本机开发用回环，容器里设为 0.0.0.0
MCP_TOOLS_PORT=8101
MCP_TOOLS_HOST=127.0.0.1
# (S7 起) 前端 nginx 端口
FRONTEND_PORT=8088

# ---------------------------------------------------------------- MySQL（两个库：fra_app 业务库、fund_data 基金数据快照库）
# 应用在 Windows 本机运行时连 127.0.0.1:MYSQL_PORT；容器内互连用服务名 mysql:3306
MYSQL_HOST=127.0.0.1
# [secret] root 密码，仅用于初始化与运维
MYSQL_ROOT_PASSWORD=
# 业务库与应用账号（只有 fra_app 库的权限）
MYSQL_APP_DB=fra_app
MYSQL_APP_USER=fra_app
# [secret]
MYSQL_APP_PASSWORD=
# 基金数据库与只读账号（fund_data 上只有 SELECT，供 mcp-tools 的 run_fund_sql 使用）
FUND_DATA_DB=fund_data
FUND_READER_USER=fund_reader
# [secret]
FUND_READER_PASSWORD=
# (S1 起) fund_data 导入账号：只有 fund_data 的读写与建表权限，仅供 data-pipeline 的 fund_pipeline.load 使用（ADR-023）
FUND_LOADER_USER=fund_loader
# [secret]
FUND_LOADER_PASSWORD=

# ---------------------------------------------------------------- Redis 8（自带 Query Engine / 向量索引）
REDIS_HOST=127.0.0.1
# [secret]
REDIS_PASSWORD=

# ---------------------------------------------------------------- Elasticsearch 8 + IK（本地开发关闭安全认证，见 ADR）
ES_URL=http://127.0.0.1:9201

# ---------------------------------------------------------------- Milvus 2.5 standalone
MILVUS_URI=http://127.0.0.1:19530

# ---------------------------------------------------------------- 健康检查
# health 接口里每个依赖探测的超时（秒）
HEALTH_TIMEOUT_SECONDS=2

# ---------------------------------------------------------------- LLM（DeepSeek，OpenAI 兼容）
LLM_BASE_URL=https://api.deepseek.com
# [secret] 由 gen_env.py 从 --llm-key-file 读取写入；不打印、不写日志
LLM_API_KEY=
# 通用对话模型（需支持流式 + tool calling）；选择依据见 docs/DECISIONS.md 与 S0 的 llm_smoke 结果
LLM_MODEL=deepseek-flash
# DeepSeek 思考模式：enabled | disabled（官方默认 enabled；开启时多轮 tool call 必须回传 reasoning_content，见 ADR）
LLM_THINKING=disabled
# (S8 起) 回答评测的 LLM 裁判模型。与被测模型同一个（ADR-046，2026-09-30 用户决定），同源偏差靠人工盲标度量
JUDGE_MODEL=deepseek-flash
# 单次 LLM 请求超时（秒）
LLM_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------- Agent（S5）
# 两个 MCP 服务的地址：mcp-tools（库 / 计算 / 净值）与 ai-service 自己的 /mcp（文档检索）；容器内互连用服务名
MCP_TOOLS_URL=http://127.0.0.1:8101/mcp
MCP_DOCS_URL=http://127.0.0.1:8001/mcp
# 单次 MCP 工具调用超时（秒）
MCP_CALL_TIMEOUT_SECONDS=30
# 文档 MCP 允许的 Host 头（JSON 列表；MCP SDK 的 DNS rebinding 防护）。容器互连时加上 "ai-service:*"
MCP_ALLOWED_HOSTS=["127.0.0.1:*","localhost:*","[::1]:*"]
# 工具调用轮数上限（PLAN S5），超出后强制无工具地作答
AGENT_MAX_STEPS=6
# run_fund_sql 报错后最多重试的次数
AGENT_SQL_RETRIES=2
# 每轮先扣留这么多字符的文本，用来吞掉「调用工具前的开场白」；0 = 不扣留（代价：最终回答前 N 个字符延后到达）
AGENT_PREAMBLE_HOLDBACK_CHARS=160

# ---------------------------------------------------------------- 本地模型（S2 起）
# bge（本地 sentence-transformers，需要 `pip install -e ".[model]"`）| fake（只用于测试/CI）
EMBEDDING_PROVIDER=bge
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_BATCH_SIZE=32
# cross_encoder | noop
RERANKER_PROVIDER=cross_encoder
RERANKER_MODEL=BAAI/bge-reranker-base
HF_ENDPOINT=https://hf-mirror.com
# 模型缓存目录（相对仓库根，已 gitignore）
MODEL_CACHE_DIR=.cache/models

# ---------------------------------------------------------------- 文档入库（S2 起）
MILVUS_COLLECTION=fund_chunks
ES_INDEX=fund_chunks
# 正文块目标字符数；超长段落硬切时的重叠字符数；表格块上限（超过按行拆分）
# CHUNK_MIN_CHARS：正文块最小字符数，不足的与相邻正文块合并（0 = 不合并；ADR-037）
CHUNK_SIZE=600
CHUNK_OVERLAP=60
TABLE_MAX_CHARS=3000
CHUNK_MIN_CHARS=150
# DATA_DIR（可选，默认仓库根下的 data/）：入库接口只接受这个目录下的文件路径

# ---------------------------------------------------------------- 检索（S4）：dev 调参后的最终配置，依据见 docs/tuning_log.md
# 模式：vector | bm25 | hybrid | vector_rerank | hybrid_rerank
RETRIEVAL_MODE=hybrid_rerank
RETRIEVAL_VECTOR_K=20
RETRIEVAL_BM25_K=20
RETRIEVAL_RRF_K=60
RETRIEVAL_RERANK_CANDIDATES=20
RETRIEVAL_TOP_N=10
RETRIEVAL_ENTITY_FILTER=false
RETRIEVAL_USE_CTX=true
RETRIEVAL_QUERY_INSTRUCTION=false
# ---------------------------------------------------------------- 数据（S1 起）
# 结构化数据截止日：S1 已冻结为 2026-09-28（取值理由见 data/CHANGELOG.md），修改须经统筹与用户批准
DATA_AS_OF=2026-09-28
# get_latest_nav 使用的东方财富净值接口（非官方，需 Referer）
NAV_API_BASE_URL=https://api.fund.eastmoney.com
# get_latest_nav：单次请求超时（秒）、失败后重试次数、成功结果缓存时长（秒）
NAV_TIMEOUT_S=3
NAV_RETRIES=2
NAV_CACHE_TTL_S=600
# run_fund_sql：返回行数上限、执行超时（秒）
SQL_MAX_ROWS=200
SQL_TIMEOUT_S=5

# ---------------------------------------------------------------- 服务间（S6 起）
# backend 调 ai-service 的地址
AI_SERVICE_BASE_URL=http://127.0.0.1:8001
# (S9 起) backend 调 ai-service 用哪种传输：grpc（默认）| http（第一期的 HTTP + SSE，保留作回退与对照）
AI_TRANSPORT=grpc
# gRPC 目标地址（host:port）与单次对话流的 deadline（到点自动取消，ai-service 的 Agent 随之被取消）
AI_SERVICE_GRPC_TARGET=127.0.0.1:50051
AI_GRPC_CHAT_DEADLINE=6m
# [secret] ai-service → backend 回调（文档入库状态）的共享密钥
INTERNAL_CALLBACK_SECRET=
# [secret] JWT 签名密钥
JWT_SECRET=
# [secret] 文档 MCP 校验「检索范围令牌」的 HMAC 密钥（ADR-043）。留空 = ai-service 每次启动随机生成（只适合单 worker）
KB_SCOPE_SECRET=
# ai-service → backend 回调（入库状态）的地址
BACKEND_BASE_URL=http://127.0.0.1:8081
# 用户上传文件的存放目录（backend 写、ai-service 读，必须在 ai-service 的 DATA_DIR 之下）。
# 留空 = ../data/uploads（相对 backend/ 目录）；上传大小上限与允许的类型见 backend 的 fra.upload.*
UPLOAD_DIR=
# 私有知识库的 Milvus 集合 / ES 索引名（公共库是 MILVUS_COLLECTION / ES_INDEX = fund_chunks）
MILVUS_USER_COLLECTION=user_chunks
ES_USER_INDEX=user_chunks
# ai-service → backend 入库回调：单次超时（秒）与重试次数（指数退避）
CALLBACK_TIMEOUT_SECONDS=5
CALLBACK_RETRIES=3
# backend：JWT 有效期；PENDING/PROCESSING 超过多久没收到入库回调就置为 FAILED；
# 对话流上游多久没有事件就放弃；传给 ai-service 的上下文轮数；SSE 心跳间隔（也是发现客户端断开的最长延迟）
JWT_TTL=12h
UPLOAD_STALE_AFTER=15m
AI_CHAT_IDLE_TIMEOUT=120s
CHAT_HISTORY_ROUNDS=6
CHAT_HEARTBEAT=1s

# ---------------------------------------------------------------- 限流与每日配额（S10，backend；Redis 故障时放行）
# 令牌桶：容量 = 允许的瞬时突发次数，补充速率 = 持续速率（个/秒）；分「每个用户」与「全局」两个维度，超限 429 + Retry-After
RATELIMIT_ENABLED=true
RATELIMIT_USER_CAPACITY=10
RATELIMIT_USER_REFILL_PER_SEC=0.5
RATELIMIT_GLOBAL_CAPACITY=100
RATELIMIT_GLOBAL_REFILL_PER_SEC=10
# 每个用户每天的调用次数与 token 上限（0 = 不限；token 是开始前检查已用量的软上限）、「一天」的时区、Redis 计数回写 MySQL 的间隔
QUOTA_DAILY_CALLS=200
QUOTA_DAILY_TOKENS=500000
QUOTA_ZONE=Asia/Shanghai
QUOTA_FLUSH_INTERVAL=30s

# ---------------------------------------------------------------- 语义缓存（S10，ai-service；默认关闭）
# 开启后，问题相近（向量相似度 ≥ 阈值）且关键要素一致（守卫）、检索范围 / 数据快照 / 模型相同的回答直接回放，不再跑 Agent。
# 阈值 0.80 是在校准集 dev 上按预先写定的规则选出的（reports/cache_calibration/，docs/perf/semantic_cache.md）；
# 守卫关掉就只剩相似度，那时零误命中的阈值是 0.995，等于不命中——不建议关
SEMANTIC_CACHE_ENABLED=false
SEMANTIC_CACHE_THRESHOLD=0.80
SEMANTIC_CACHE_GUARD=true
SEMANTIC_CACHE_TTL_SECONDS=86400
SEMANTIC_CACHE_MAX_ANSWER_CHARS=20000
# 公共库的版本串（进缓存命名空间）；留空 = 取 data/MANIFEST.json 的 sha256 前 12 位
KB_PUBLIC_VERSION=
