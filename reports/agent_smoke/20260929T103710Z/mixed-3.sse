event: citations
data: {"items": [{"id": 1, "kind": "document", "fund_code": "008919", "fund_name": "永赢科技驱动混合", "doc_id": "008919_quarterly_report_2026Q2", "doc_type": "quarterly_report", "doc_title": "2026年第2季度报告", "report_period": "2026Q2", "page_start": 7, "page_end": 7, "section": "4.4 报告期内基金的投资策略和运作分析", "snippet": "4.4 报告期内基金的投资策略和运作分析\n2026年二季度，国内经济出现一定的分化，内需和投资两项环比走弱。其中消费走弱可能和消费补贴力度减弱有关，同时也和持续多年的更新换代进入末期有关；投资低于预期主要和年内投资节奏和项目开工节奏挂钩，我们认为投资将会在未来一段时期边际企稳。出口依然较为亮眼，是中国经济企稳向好的中坚力量。此外二季度中东冲突不断缓和，但霍尔木兹海峡依然并没有实质性开放，因此全球油气供应链依然承压，各国更多通过消化库存的方式共克时艰，我们认为三季度美伊达成协议的概率较大，届时全球将会进入到油气补库周期，前期走软的油气价格将会重新进入到上升通道，因此全球通胀压力并不会立即缓解，据此我们预测美联储并不会立刻放松加息预期，全球流动性依然边际趋紧。\n二季度，我们抓住美伊冲突对资本市场的冲击机会，逐步加仓了以AI为代表的科技板块，这其中我们继续看好光通信、存储和PCB产业链。我们看到"}, {"id": 4, "kind": "document", "fund_code": "008919", "fund_name": "永赢科技驱动混合", "doc_id": "008919_quarterly_report_2026Q2", "doc_type": "quarterly_report", "doc_title": "2026年第2季度报告", "report_period": "2026Q2", "page_start": 9, "page_end": 9, "section": "5.2.2 报告期末按行业分类的港股通投资股票投资组合", "snippet": "5.2.2 报告期末按行业分类的港股通投资股票投资组合\n本基金本报告期末未持有港股通投资股票。"}, {"id": 7, "kind": "document", "fund_code": "008919", "fund_name": "永赢科技驱动混合", "doc_id": "008919_quarterly_report_2026Q2", "doc_type": "quarterly_report", "doc_title": "2026年第2季度报告", "report_period": "2026Q2", "page_start": 8, "page_end": 8, "section": "5.2.1 报告期末按行业分类的境内股票投资组合", "snippet": "| 代码 | 行业类别 | 公允价值（元） | 占基金资产净值比例（%） |\n|---|---|---|---|\n| A | 农、林、牧、渔业 | - | - |\n| B | 采矿业 | 496,636,911.15 | 5.21 |\n| C | 制造业 | 6,315,991,444.14 | 66.22 |\n| D | 电力、热力、燃气及水生产和供应业 | - | - |\n| E | 建筑业 | 384,762,172.00 | 4.03 |\n| F | 批发和零售业 | 453,990,000.00 | 4.76 |\n| G | 交通运输、仓储和邮政业 | - | - |\n| H | 住宿和餐饮业 | - | - |\n| I | 信息传输、软件和信息技术服务业 | - | - |\n| J | 金融业 | - | - |\n| K | 房地产业 | - | - |\n| L | 租赁和商务"}, {"id": 9, "kind": "database", "tables": ["holdings_top10"], "source": "fund_data（MySQL 快照库）表 holdings_top10", "as_of": "2026-09-28", "sql": "SELECT rank_no, stock_code, stock_name, weight, shares, market_value, source, as_of FROM holdings_top10 WHERE fund_code = '008919' AND report_period = '2026Q2' ORDER BY rank_no LIMIT 201", "row_count": 10}]}

