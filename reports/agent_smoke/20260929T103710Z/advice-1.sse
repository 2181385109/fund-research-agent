data: {"call_id": "call_00_3SLZcJpccPYWpQmVzbDd9849", "name": "run_fund_sql", "args": {"sql": "SELECT f.fund_code, f.fund_name, f.theme, f.style, f.fund_type, f.company, f.established, f.benchmark FROM funds f WHERE f.fund_code IN ('003095','001513')"}, "step": 2}

