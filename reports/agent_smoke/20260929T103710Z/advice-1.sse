data: {"items": [{"id": 2, "kind": "document", "fund_code": "003095", "fund_name": "中欧医疗健康混合", "doc_id": "003095_prospectus_2026-09-21", "doc_type": "prospectus", "doc_title": "招募说明书（2026-09-21更新）", "report_period": "2026-09-21", "page_start": 44, "page_end": 45, "section": "三、投资策略", "snippet": "（4）对于存托凭证的投资，本基金将依照境内上市交易的股票，通过定性分析和定量分析相结合的方式，精选优质上市公司；并最大限度避免由于存托凭证在交易规则、上市公司治理结构等方面的差异而或有的负面影响。\n3、债券投资策略本基金考察国内宏观经济景气周期引发的债券市场收益率的变化趋势，采取利率预期、久期管理、收益率曲线策略等积极投资策略，力求获取高于业绩比较基准的回报。\n4、股指期货投资策略本基金投资股指期货将根据风险管理的原则，主要选择流动性好、交易活跃的股指期货合约。本基金力争利用股指期货的杠杆作用，降低股票仓位频繁调整的交易成本。\n5、资产支持证券投资策略在控制风险的前提下，本基金对资产支持证券从五个方面综合定价，选择低估的品种进行投资。五个方面包括信用因素、流动性因素、利率因素、税收因素和提前还款因素。而当前的信用因素是需要重点考虑的因素。\n6、中小企业私募债投资策略与传统的信用债券相比，中"}, {"id": 3, "kind": "document", "fund_code": "001513", "fund_name": "易方达信息产业混合", "doc_id": "001513_prospectus_2026-06-01", "doc_type": "prospectus", "doc_title": "招募说明书（2026-06-01更新）", "report_period": "2026-06-01", "page_start": 78, "page_end": 78, "section": "（一）本基金的特有风险", "snippet": "二十、风险揭示\n（一）本基金的特有风险\n1、资产配置风险。本基金股票资产占基金资产的比例为 60%-95%，属于股票仓位偏高且相对稳定的基金品种，受股票市场系统性风险影响较大，如果股票市场出现整体下跌，本基金的净值表现将受到影响，投资者面临无法获得收益甚至可能发生较大亏损的风险。\n2、信息产业证券集中度较高的风险。本基金非现金资产中不低于 80%的资产将投资于信息产业证券，须承受与信息产业相关的特有风险。本基金对于信息产业证券定义和筛选标准的确定是基于上市公司过往历史数据及其他多方面因素，不预示其未来表现，因此最终能否带来收益具有较大不确定性。同时本基金投资于股票市场所获取的收益受多种因素影响，因此即便根据投资策略投资于信息产业股票，也不意味着本基金一定盈利。本基金非现金资产中较大比例资产投资信息产业证券，当信息产业证券表现不佳时，本基金的净值将会受到较大影响。投资者须在理性判断的基础上做"}, {"id": 6, "kind": "document", "fund_code": "003095", "fund_name": "中欧医疗健康混合", "doc_id": "003095_prospectus_2026-09-21", "doc_type": "prospectus", "doc_title": "招募说明书（2026-09-21更新）", "report_period": "2026-09-21", "page_start": 45, "page_end": 45, "section": "三、投资策略", "snippet": "8、股票期权投资策略本基金将按照风险管理的原则，以套期保值为主要目的，参与股票期权的投资。本基金将在有效控制风险的前提下，选择流动性好、交易活跃的期权合约进行投资。本基金将基于对证券市场的预判，并结合股指期权定价模型，选择估值合理的期权合约。\n基金管理人将根据审慎原则，建立股票期权交易决策部门或小组，按照有关要求做好人员培训工作，确保投资、风控等核心岗位人员具备股票期权业务知识和相应的专业能力，同时授权特定的管理人员负责股票期权的投资审批事项，以防范期权投资的风险。"}, {"id": 7, "kind": "database", "tables": ["funds"], "source": "fund_data（MySQL 快照库）表 funds", "as_of": "2026-09-28", "sql": "SELECT f.fund_code, f.fund_name, f.theme, f.style, f.fund_type, f.company, f.established, f.benchmark FROM funds AS f WHERE f.fund_code IN ('003095', '001513') LIMIT 201", "row_count": 2}, {"id": 8, "kind": "database", "tables": ["fees"], "source": "fund_data（MySQL 快照库）表 fees", "as_of": "2026-09-28", "sql": "SELECT share_code, management_fee, custody_fee, sales_service_fee FROM fees WHERE share_code IN ('003095', '003096', '001513', '019018') LIMIT 201", "row_count": 4}, {"id": 9, "kind": "database", "tables": ["fund_scale"], "source": "fund_data（MySQL 快照库）表 fund_scale", "as_of": "2026-09-28", "sql": "SELECT fund_code, report_date, net_assets FROM fund_scale WHERE fund_code IN ('003095', '001513') ORDER BY fund_code, report_date LIMIT 201", "row_count": 4}, {"id": 10, "kind": "database", "tables": ["period_returns"], "source": "fund_data（MySQL 快照库）表 period_returns", "as_of": "2026-09-28", "sql": "SELECT share_code, period, ret, end_date FROM period_returns WHERE share_code IN ('003095', '001513') ORDER BY share_code, period LIMIT 201", "row_count": 18}, {"id": 11, "kind": "database", "tables": ["holdings_top10"], "source": "fund_data（MySQL 快照库）表 holdings_top10", "as_of": "2026-09-28", "sql": "SELECT fund_code, report_period, rank_no, stock_name, weight FROM holdings_top10 WHERE fund_code IN ('003095', '001513') AND report_period = (SELECT MAX(report_period) FROM holdings_top10 WHERE fund_code = '003095') ORDER BY fund_code, rank_no LIMIT 201", "row_count": 20}, {"id": 12, "kind": "database", "tables": ["fund_manager_tenures"], "source": "fund_data（MySQL 快照库）表 fund_manager_tenures", "as_of": "2026-09-28", "sql": "SELECT fund_code, manager_name, start_date, end_date FROM fund_manager_tenures WHERE fund_code IN ('003095', '001513') ORDER BY fund_code, start_date LIMIT 201", "row_count": 3}, {"id": 13, "kind": "computation", "tool": "calc_fund_return", "args": {"share_code": "003095", "start": "2024-09-28", "end": "2026-09-28"}, "share_code": "003095", "start_used": "2024-09-27", "end_used": "2026-09-28", "source": "fund_data.nav_daily / fund_data.dividends（快照）", "as_of": "2026-09-28"}, {"id": 14, "kind": "computation", "tool": "calc_fund_return", "args": {"share_code": "001513", "start": "2024-09-28", "end": "2026-09-28"}, "share_code": "001513", "start_used": "2024-09-27", "end_used": "2026-09-28", "source": "fund_data.nav_daily / fund_data.dividends（快照）", "as_of": "2026-09-28"}, {"id": 15, "kind": "computation", "tool": "calc_fund_return", "args": {"share_code": "003095", "start": "2026-01-01", "end": "2026-09-28"}, "share_code": "003095", "start_used": "2025-12-31", "end_used": "2026-09-28", "source": "fund_data.nav_daily / fund_data.dividends（快照）", "as_of": "2026-09-28"}, {"id": 16, "kind": "computation", "tool": "calc_fund_return", "args": {"share_code": "001513", "start": "2026-01-01", "end": "2026-09-28"}, "share_code": "001513", "start_used": "2025-12-31", "end_used": "2026-09-28", "source": "fund_data.nav_daily / fund_data.dividends（快照）", "as_of": "2026-09-28"}]}

