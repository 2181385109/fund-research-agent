data: {"call_id": "call_01_62Wpko5S64qmSvPZCjvU3891", "name": "run_fund_sql", "args": {"sql": "SELECT share_code, management_fee, custody_fee, sales_service_fee FROM fees WHERE share_code IN ('003095','003096','001513','019018')"}, "step": 2}

