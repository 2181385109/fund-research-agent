event: tool_end
data: {"call_id": "call_01_q0X2iBiZc1DQL57gwOae5953", "name": "search_fund_documents", "duration_ms": 4158.4, "status": "ok", "summary": "检索到 8 个片段", "citation_ids": [1, 2, 3, 4, 5, 6, 7, 8]}

event: tool_start
data: {"call_id": "call_00_zZABKiVEO311szrCI6BV1281", "name": "run_fund_sql", "args": {"sql": "SELECT f.fund_code, f.fund_name, s.share_code, s.share_class, fe.management_fee, fe.custody_fee, fe.sales_service_fee, fe.as_of FROM funds f JOIN share_classes s ON s.fund_code=f.fund_code JOIN fees fe ON fe.share_code=s.share_code WHERE f.fund_code IN ('003095','000452')"}, "step": 2}

event: tool_end
data: {"call_id": "call_00_zZABKiVEO311szrCI6BV1281", "name": "run_fund_sql", "duration_ms": 281.1, "status": "ok", "summary": "返回 4 行", "citation_ids": [9]}

event: tool_start
data: {"call_id": "call_01_UZoswDTmE5vKBEa3lApU7077", "name": "run_fund_sql", "args": {"sql": "SELECT fund_code, report_date, net_assets, source, as_of FROM fund_scale WHERE fund_code IN ('003095','000452') ORDER BY fund_code, report_date DESC"}, "step": 2}

event: tool_end
data: {"call_id": "call_01_UZoswDTmE5vKBEa3lApU7077", "name": "run_fund_sql", "duration_ms": 277.9, "status": "ok", "summary": "返回 4 行", "citation_ids": [10]}

