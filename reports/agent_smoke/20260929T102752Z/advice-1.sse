event: tool_start
data: {"call_id": "call_01_qBYGU4GewCekKlMX3IQY1430", "name": "run_fund_sql", "args": {"sql": "SELECT share_code, period, ret, end_date FROM period_returns WHERE share_code IN ('003095','001513') ORDER BY share_code, period"}, "step": 2}

event: tool_end
data: {"call_id": "call_01_qBYGU4GewCekKlMX3IQY1430", "name": "run_fund_sql", "duration_ms": 274.1, "status": "ok", "summary": "返回 18 行", "citation_ids": [4]}

