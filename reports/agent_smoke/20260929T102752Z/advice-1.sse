data: {"items": [{"id": 1, "kind": "api", "share_code": "003095", "source": "东方财富 api.fund.eastmoney.com/f10/lsjz（非官方接口）", "nav_date": "2026-09-28", "fetched_at": "2026-09-29T10:28:43+00:00", "stale": false}, {"id": 2, "kind": "api", "share_code": "001513", "source": "东方财富 api.fund.eastmoney.com/f10/lsjz（非官方接口）", "nav_date": "2026-09-28", "fetched_at": "2026-09-29T10:28:46+00:00", "stale": false}, {"id": 3, "kind": "database", "tables": ["funds"], "source": "fund_data（MySQL 快照库）表 funds", "as_of": "2026-09-28", "sql": "SELECT fund_code, fund_name, fund_type, theme, style, company, established, benchmark FROM funds WHERE fund_code IN ('003095', '001513') LIMIT 201", "row_count": 2}, {"id": 4, "kind": "database", "tables": ["period_returns"], "source": "fund_data（MySQL 快照库）表 period_returns", "as_of": "2026-09-28", "sql": "SELECT share_code, period, ret, end_date FROM period_returns WHERE share_code IN ('003095', '001513') ORDER BY share_code, period LIMIT 201", "row_count": 18}, {"id": 5, "kind": "database", "tables": ["fees"], "source": "fund_data（MySQL 快照库）表 fees", "as_of": "2026-09-28", "sql": "SELECT share_code, management_fee, custody_fee, sales_service_fee FROM fees WHERE share_code IN ('003095', '003096', '001513', '019018') LIMIT 201", "row_count": 4}, {"id": 6, "kind": "database", "tables": ["fund_scale"], "source": "fund_data（MySQL 快照库）表 fund_scale", "as_of": "2026-09-28", "sql": "SELECT fund_code, report_date, net_assets FROM fund_scale WHERE fund_code IN ('003095', '001513') ORDER BY fund_code, report_date DESC LIMIT 201", "row_count": 4}, {"id": 7, "kind": "database", "tables": ["holdings_top10"], "source": "fund_data（MySQL 快照库）表 holdings_top10", "as_of": "2026-09-28", "sql": "SELECT fund_code, report_period, rank_no, stock_name, weight FROM holdings_top10 WHERE fund_code IN ('003095', '001513') AND report_period = (SELECT MAX(report_period) FROM holdings_top10 WHERE fund_code IN ('003095', '001513')) ORDER BY fund_code, rank_no LIMIT 201", "row_count": 20}, {"id": 8, "kind": "computation", "tool": "calc_fund_return", "args": {"share_code": "003095", "start": "2025-09-28", "end": "2026-09-28"}, "share_code": "003095", "start_used": "2025-09-26", "end_used": "2026-09-28", "source": "fund_data.nav_daily / fund_data.dividends（快照）", "as_of": "2026-09-28"}, {"id": 9, "kind": "computation", "tool": "calc_fund_return", "args": {"share_code": "001513", "start": "2025-09-28", "end": "2026-09-28"}, "share_code": "001513", "start_used": "2025-09-26", "end_used": "2026-09-28", "source": "fund_data.nav_daily / fund_data.dividends（快照）", "as_of": "2026-09-28"}]}

