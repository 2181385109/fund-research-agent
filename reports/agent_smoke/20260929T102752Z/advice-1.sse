data: {"call_id": "call_00_Mm9mPSL3phT71sbvlAcU1907", "name": "run_fund_sql", "args": {"sql": "SELECT fund_code, fund_name, fund_type, theme, style, company, established, benchmark FROM funds WHERE fund_code IN ('003095','001513')"}, "step": 2}

