data: {"call_id": "call_03_CLLeq68QhOR04hjjExZU7141", "name": "run_fund_sql", "args": {"sql": "SELECT fund_code, report_date, net_assets FROM fund_scale WHERE fund_code IN ('003095','001513') ORDER BY fund_code, report_date DESC"}, "step": 2}

event: tool_end
data: {"call_id": "call_03_CLLeq68QhOR04hjjExZU7141", "name": "run_fund_sql", "duration_ms": 271.0, "status": "ok", "summary": "返回 4 行", "citation_ids": [6]}

