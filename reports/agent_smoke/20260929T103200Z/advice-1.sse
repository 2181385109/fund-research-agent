data: {"items": [{"id": 5, "kind": "document", "fund_code": "001513", "fund_name": "易方达信息产业混合", "doc_id": "001513_prospectus_2026-06-01", "doc_type": "prospectus", "doc_title": "招募说明书（2026-06-01更新）", "report_period": "2026-06-01", "page_start": 78, "page_end": 78, "section": "（一）本基金的特有风险", "snippet": "二十、风险揭示\n（一）本基金的特有风险\n1、资产配置风险。本基金股票资产占基金资产的比例为 60%-95%，属于股票仓位偏高且相对稳定的基金品种，受股票市场系统性风险影响较大，如果股票市场出现整体下跌，本基金的净值表现将受到影响，投资者面临无法获得收益甚至可能发生较大亏损的风险。\n2、信息产业证券集中度较高的风险。本基金非现金资产中不低于 80%的资产将投资于信息产业证券，须承受与信息产业相关的特有风险。本基金对于信息产业证券定义和筛选标准的确定是基于上市公司过往历史数据及其他多方面因素，不预示其未来表现，因此最终能否带来收益具有较大不确定性。同时本基金投资于股票市场所获取的收益受多种因素影响，因此即便根据投资策略投资于信息产业股票，也不意味着本基金一定盈利。本基金非现金资产中较大比例资产投资信息产业证券，当信息产业证券表现不佳时，本基金的净值将会受到较大影响。投资者须在理性判断的基础上做"}, {"id": 6, "kind": "document", "fund_code": "001513", "fund_name": "易方达信息产业混合", "doc_id": "001513_prospectus_2026-06-01", "doc_type": "prospectus", "doc_title": "招募说明书（2026-06-01更新）", "report_period": "2026-06-01", "page_start": 51, "page_end": 52, "section": "（四）业绩比较基准", "snippet": "（1）原有业绩比较基准的要素无法持续运作、编制方案发生重大修订等客观因素导致业绩比较基准无法再表征基金产品投资风格，或不再符合基金合同关于投资目标、投资范围、投资策略、投资比例限制等的约定，或与主要的资产类别、国别或地区、市场板块、货币类型等不再匹配；或业绩比较基准的要素不再具备市场代表性；\n（2）调整业绩比较基准的要素权重、更换相同或相近特征的要素等，使新业绩比较基准代表性更强，且符合相关法律法规规定的；\n（3）中国证监会认可的其他情形。\n业绩比较基准变更涉及以下情形的，基金管理人应当按照规定履行变更注册、召开基金份额持有人大会等程序，法律法规、中国证监会另有规定的除外：\n（1）基金投资目标、投资范围、投资策略、投资比例等拟进行重大调整，并变更业绩比较基准的；\n（2）其他对基金份额持有人利益产生重大实质性影响的情形。\n（五）风险收益特征\n本基金为混合基金，理论上其预期风险与预期收益水平低"}, {"id": 7, "kind": "database", "tables": ["funds"], "source": "fund_data（MySQL 快照库）表 funds", "as_of": "2026-09-28", "sql": "SELECT fund_code, fund_name, fund_type, theme, style, company, established, benchmark FROM funds WHERE fund_code IN ('003095', '001513') LIMIT 201", "row_count": 2}, {"id": 8, "kind": "database", "tables": ["fees"], "source": "fund_data（MySQL 快照库）表 fees", "as_of": "2026-09-28", "sql": "SELECT share_code, management_fee, custody_fee, sales_service_fee FROM fees WHERE share_code IN ('003095', '003096', '001513', '019018') LIMIT 201", "row_count": 4}, {"id": 9, "kind": "database", "tables": ["period_returns"], "source": "fund_data（MySQL 快照库）表 period_returns", "as_of": "2026-09-28", "sql": "SELECT share_code, period, ret, end_date FROM period_returns WHERE share_code IN ('003095', '001513') ORDER BY share_code, period LIMIT 201", "row_count": 18}, {"id": 10, "kind": "database", "tables": ["fund_scale"], "source": "fund_data（MySQL 快照库）表 fund_scale", "as_of": "2026-09-28", "sql": "SELECT fund_code, report_date, net_assets FROM fund_scale WHERE fund_code IN ('003095', '001513') ORDER BY fund_code, report_date DESC LIMIT 201", "row_count": 4}, {"id": 11, "kind": "database", "tables": ["holdings_top10"], "source": "fund_data（MySQL 快照库）表 holdings_top10", "as_of": "2026-09-28", "sql": "SELECT fund_code, report_period, rank_no, stock_name, weight FROM holdings_top10 WHERE fund_code IN ('003095', '001513') AND report_period = (SELECT MAX(report_period) FROM holdings_top10 WHERE fund_code IN ('003095', '001513')) ORDER BY fund_code, rank_no LIMIT 201", "row_count": 20}, {"id": 12, "kind": "computation", "tool": "calc_fund_return", "args": {"share_code": "003095", "start": "2025-09-28", "end": "2026-09-28"}, "share_code": "003095", "start_used": "2025-09-26", "end_used": "2026-09-28", "source": "fund_data.nav_daily / fund_data.dividends（快照）", "as_of": "2026-09-28"}, {"id": 13, "kind": "computation", "tool": "calc_fund_return", "args": {"share_code": "001513", "start": "2025-09-28", "end": "2026-09-28"}, "share_code": "001513", "start_used": "2025-09-26", "end_used": "2026-09-28", "source": "fund_data.nav_daily / fund_data.dividends（快照）", "as_of": "2026-09-28"}]}

