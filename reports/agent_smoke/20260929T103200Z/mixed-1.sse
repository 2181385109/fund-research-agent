event: tool_end
data: {"call_id": "call_02_GfqLDZiQHwZZuyo7oo8K7702", "name": "search_fund_documents", "duration_ms": 3964.8, "status": "ok", "summary": "检索到 5 个片段", "citation_ids": [6, 7, 8, 9, 10]}

event: tool_start
data: {"call_id": "call_00_OIEvilVOnrPZDtWgxrvb7173", "name": "run_fund_sql", "args": {"sql": "SELECT share_code, management_fee, custody_fee, sales_service_fee, source, as_of FROM fees WHERE share_code IN ('003095','003096','000452','014933')"}, "step": 2}

event: tool_end
data: {"call_id": "call_00_OIEvilVOnrPZDtWgxrvb7173", "name": "run_fund_sql", "duration_ms": 252.2, "status": "ok", "summary": "返回 4 行", "citation_ids": [11]}

event: tool_start
data: {"call_id": "call_01_VLhyXrJ7VqaCqkfX4sZ64900", "name": "run_fund_sql", "args": {"sql": "SELECT fund_code, report_date, net_assets, source, as_of FROM fund_scale WHERE fund_code IN ('003095','000452') ORDER BY fund_code, report_date DESC"}, "step": 2}

event: tool_end
data: {"call_id": "call_01_VLhyXrJ7VqaCqkfX4sZ64900", "name": "run_fund_sql", "duration_ms": 255.0, "status": "ok", "summary": "返回 4 行", "citation_ids": [12]}

